// Cloudflare Workers static-assets deployment of the HashAtlas dashboard (no Worker script).
// Build first (`bun run build`), then `bunx wrangler deploy`. Hash routing: every page is /index.html.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hashatlas",
  "compatibility_date": "2026-11-12",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "cds3004.ansonlo.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
