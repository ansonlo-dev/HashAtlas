{
  "name": "hashatlas-web",
  "private": true,
  "version": "1.0.0",
  "description": "HashAtlas: interactive Bitcoin mining intelligence dashboard (CDS3004 group project)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "validate-data": "bun run scripts/validate-data.ts",
    "deploy": "vite build && wrangler deploy",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
